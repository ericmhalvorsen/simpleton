# llama.cpp Multi-GPU Configuration
# Copy this to .env and adjust for your setup

# =============================================================================
# GPU CONFIGURATION
# =============================================================================

# Which GPUs to make visible to llama.cpp (comma-separated)
# Examples:
#   - Single GPU: CUDA_VISIBLE_DEVICES=0
#   - Two GPUs: CUDA_VISIBLE_DEVICES=0,1
#   - Four GPUs: CUDA_VISIBLE_DEVICES=0,1,2,3
#   - Skip GPU 1: CUDA_VISIBLE_DEVICES=0,2,3
CUDA_VISIBLE_DEVICES=0,1,2,3

# Enable/disable peer-to-peer GPU memory copy
# 0 = enabled (faster, requires NVLink or similar), 1 = disabled (slower, works everywhere)
GGML_CUDA_NO_PEER_COPY=0

# =============================================================================
# LLAMA.CPP SERVER SETTINGS
# =============================================================================

# Model file path (relative to /app/models in container)
# Download GGUF models from HuggingFace
MODEL_PATH=/app/models/model.gguf

# Number of GPU layers to offload (-1 = all layers)
# Set to -1 for full GPU offload, or a specific number for hybrid CPU/GPU
N_GPU_LAYERS=-1

# Split mode for multi-GPU inference
# Options:
#   - "none": Single GPU (no splitting)
#   - "layer": Split layers across GPUs (layer parallelism)
#   - "row": Split weight matrices row-wise (tensor parallelism) - RECOMMENDED for multi-GPU
SPLIT_MODE=row

# Tensor split ratios (comma-separated, must match number of GPUs)
# Examples:
#   - Equal split (2 GPUs): TENSOR_SPLIT=1,1
#   - Equal split (4 GPUs): TENSOR_SPLIT=1,1,1,1
#   - Unequal split (more work on GPU 0): TENSOR_SPLIT=2,1,1,1
#   - Use only first two GPUs: TENSOR_SPLIT=1,1,0,0
TENSOR_SPLIT=1,1,1,1

# Context window size (tokens)
# Larger = more memory usage, slower inference
# Common values: 2048, 4096, 8192, 16384, 32768
CTX_SIZE=4096

# Number of CPU threads for operations not on GPU
# Set to number of CPU cores, or lower if running other services
THREADS=8

# Batch size for prompt processing
# Higher = faster prompt ingestion, more VRAM usage
BATCH_SIZE=512

# Server port
LLAMA_PORT=8080

# =============================================================================
# MODEL RECOMMENDATIONS BY GPU COUNT
# =============================================================================

# 2x GPUs (24GB each = 48GB total):
#   - Llama-3-70B-Q4_K_M (35-40GB VRAM)
#   - Mixtral-8x7B-Q5_K_M (40-45GB VRAM)

# 4x GPUs (24GB each = 96GB total):
#   - Llama-3-70B-Q8_0 (70GB VRAM)
#   - Llama-3.1-405B-Q2_K (100GB+ VRAM)
#   - Qwen2.5-72B-Q6_K (60-70GB VRAM)

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Your application's API keys
API_KEYS=changeme

# URLs for dependent services
LLAMA_CPP_URL=http://llamacpp:8080
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379
NTFY_URL=http://ntfy:80
