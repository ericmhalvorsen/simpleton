# vLLM Multi-GPU Configuration
# Copy this to .env and adjust for your setup

# =============================================================================
# GPU CONFIGURATION
# =============================================================================

# Which NVIDIA GPUs to make visible to vLLM (comma-separated)
# NOTE: vLLM only supports NVIDIA GPUs with CUDA. Intel Arc GPUs will be ignored.
# Examples:
#   - Single GPU: CUDA_VISIBLE_DEVICES=0
#   - Two GPUs: CUDA_VISIBLE_DEVICES=0,1
#   - Four GPUs: CUDA_VISIBLE_DEVICES=0,1,2,3
#   - Skip GPU 1: CUDA_VISIBLE_DEVICES=0,2,3
CUDA_VISIBLE_DEVICES=0,1,2,3

# Number of GPUs to use for tensor parallelism
# Must be <= number of GPUs in CUDA_VISIBLE_DEVICES
# vLLM automatically distributes the model across these GPUs
TENSOR_PARALLEL_SIZE=4

# Pipeline parallelism size (for extremely large models like 405B+)
# Usually keep at 1 unless you have 8+ GPUs and a massive model
# Tensor parallelism is preferred over pipeline parallelism
PIPELINE_PARALLEL_SIZE=1

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Model to load - can be:
#   - HuggingFace model ID: meta-llama/Llama-2-70b-chat-hf
#   - Local path: /app/models/llama-2-70b-chat
# For gated models (Llama, etc.), set HF_TOKEN below
MODEL_NAME=meta-llama/Llama-2-70b-chat-hf

# HuggingFace token for gated models (Llama, Gemma, etc.)
# Get yours at: https://huggingface.co/settings/tokens
# Leave empty for public models
HF_TOKEN=

# Maximum sequence length (context window) in tokens
# Larger = more memory usage
# Common values: 2048, 4096, 8192, 16384, 32768
# Note: Some models have hard limits (e.g., Llama 2 = 4096, Llama 3.1 = 128k)
MAX_MODEL_LEN=4096

# Trust remote code (required for some models like Qwen, Phi, etc.)
# Set to true if the model requires custom code
TRUST_REMOTE_CODE=false

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# GPU memory utilization (0.0 to 1.0)
# How much of GPU VRAM to use for model and KV cache
# Higher = more capacity for concurrent requests, but less safety margin
# Recommended: 0.85-0.95
# If you get OOM errors, reduce this
GPU_MEMORY_UTILIZATION=0.90

# Maximum number of sequences to process in parallel (batch size)
# Higher = better throughput with many concurrent requests
# Lower = lower latency for individual requests
# Adjust based on your use case:
#   - Single user / low concurrency: 32-64
#   - Medium concurrency (10-50 users): 128-256
#   - High concurrency (100+ users): 256-512
MAX_NUM_SEQS=256

# Maximum number of batched tokens
# Controls how many tokens can be processed in a single forward pass
# Auto-calculated if not set (recommended)
# MAX_NUM_BATCHED_TOKENS=8192

# Enable chunked prefill for better latency
# Breaks long prompts into chunks to avoid blocking short requests
# Recommended: true for production
ENABLE_CHUNKED_PREFILL=true

# =============================================================================
# QUANTIZATION (Optional)
# =============================================================================

# Quantization method for reducing memory usage
# Options: awq, gptq, squeezellm, fp8
# Leave empty for no quantization (full precision)
# Note: Model must be pre-quantized in this format (e.g., TheBloke's quantized models)
# QUANTIZATION=awq

# Load format (auto-detect if not specified)
# Options: auto, pt, safetensors, npcache, dummy
# LOAD_FORMAT=auto

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Server host and port
HOST=0.0.0.0
PORT=8000

# Disable request logging (reduces overhead in production)
DISABLE_LOG_REQUESTS=true

# =============================================================================
# NCCL SETTINGS (Multi-GPU Communication)
# =============================================================================

# NCCL debug level (WARN, INFO, TRACE)
# Use INFO or TRACE for debugging multi-GPU issues
NCCL_DEBUG=WARN

# InfiniBand settings (0 = enabled, 1 = disabled)
# Keep enabled if you have InfiniBand networking
NCCL_IB_DISABLE=0

# Peer-to-peer GPU communication (0 = enabled, 1 = disabled)
# Keep enabled for better performance (requires NVLink or PCIe P2P)
NCCL_P2P_DISABLE=0

# Shared memory (0 = enabled, 1 = disabled)
NCCL_SHM_DISABLE=0

# GPUDirect RDMA level (0-5, higher = more aggressive)
# Set to 2 or higher if you have NVLink/NVSwitch
NCCL_NET_GDR_LEVEL=2

# =============================================================================
# MODEL RECOMMENDATIONS BY GPU COUNT & USE CASE
# =============================================================================

# Single GPU (24GB):
#   - Llama-2-7b-chat-hf (full precision) - 10+ concurrent users
#   - Llama-2-13b-chat-hf (full precision) - 5-10 concurrent users
#   - Mistral-7B-Instruct-v0.2 (full precision) - 15+ concurrent users

# 2x GPUs (24GB each = 48GB total):
#   - Llama-2-70b-chat-hf (tensor parallel) - 20-50 concurrent users
#   - mixtral-8x7b-instruct-v0.1 (tensor parallel) - 30-60 concurrent users
#   - CodeLlama-70b-Instruct-hf - 15-40 concurrent users

# 4x GPUs (24GB each = 96GB total):
#   - Llama-2-70b-chat-hf (tensor parallel, high batch) - 100+ concurrent users
#   - Qwen-72B-Chat (tensor parallel) - 80+ concurrent users
#   - Mixtral-8x22B (if available) - 50+ concurrent users

# 8x GPUs (24GB each = 192GB total):
#   - Llama-3.1-405B-Instruct (tensor parallel) - 50-100+ concurrent users
#   - Any 70B model with very high concurrency (500+ users)

# =============================================================================
# THROUGHPUT OPTIMIZATION TIPS
# =============================================================================

# 1. Use tensor parallelism over pipeline parallelism when possible
#    TENSOR_PARALLEL_SIZE=4 is better than PIPELINE_PARALLEL_SIZE=4

# 2. Increase MAX_NUM_SEQS for high concurrency workloads
#    More concurrent requests = better GPU utilization

# 3. Set GPU_MEMORY_UTILIZATION to 0.90-0.95
#    Higher utilization = more KV cache = more concurrent requests

# 4. Enable ENABLE_CHUNKED_PREFILL for mixed workloads
#    Prevents long prompts from blocking short requests

# 5. Use quantization (AWQ/GPTQ) for larger models or higher throughput
#    Trade minimal quality loss for 2-4x memory savings

# 6. Ensure good GPU interconnect (NVLink > PCIe)
#    Check with: nvidia-smi topo -m

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Your application's API keys
API_KEYS=changeme

# URLs for dependent services
VLLM_URL=http://vllm:8000
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379
NTFY_URL=http://ntfy:80
